{
    "buildCommand": "pnpm --filter web build",
    "outputDirectory": "apps/web/dist",
    "git": {
        "deploymentEnabled": {
            "Production": true,
            "*": false
        }
    },
    "rewrites": [
        {
            "source": "/api/cron/:path*",
            "destination": "https://api.clawds.io/cron/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "crons": [
        {
            "path": "/api/cron/send-feature-emails",
            "schedule": "0 9 * * *"
        }
    ]
}